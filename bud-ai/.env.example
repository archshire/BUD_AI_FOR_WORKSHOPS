# LiveKit settings for the teacher-hosted prototype
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=bud-demo-room

# Future provider settings
STT_PROVIDER=dev
LLM_PROVIDER=dev

# Translation backend: groq | gemini | qwen | nllb
# Left unset, Groq is used when GROQ_API_KEY is present, then Gemini when
# GEMINI_API_KEY is present, and NLLB otherwise.
# "qwen" reuses the local Qwen container already in the stack (no key, weaker).
# Whichever is chosen, the local NLLB container remains the fallback on failure.
TRANSLATION_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Hosted speech-to-text (Groq, whisper-large-v3).
# Set GROQ_API_KEY and it is used automatically, with the local Whisper container
# below as the fallback. Set STT_PROVIDER=local to force the local container.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_TRANSLATE_MODEL=llama-3.3-70b-versatile

# Hallucination guards on the hosted transcriber. Whisper answers background noise with
# invented subtitle text; these are the per-segment scores that catch it. Raise
# NO_SPEECH (towards 1) to keep more borderline audio, lower it (towards 0) to be
# stricter in a noisy room. LOG_PROB is average token confidence in log space —
# raise it towards 0 to drop more guessed text. COMPRESSION_RATIO catches a decoder
# stuck repeating itself; lower it to cut looping text sooner.
STT_NO_SPEECH_THRESHOLD=0.6
STT_LOG_PROB_THRESHOLD=-1.0
STT_COMPRESSION_RATIO_THRESHOLD=2.4

# Local Whisper service
STT_HOST=127.0.0.1
STT_PORT=8787
WHISPER_MODEL=small
TRANSLATION_HOST=127.0.0.1
TRANSLATION_PORT=8788

# Local Qwen service — writes Bud's chat replies.
# "make" downloads the default 1GB Qwen3-1.7B model into the qwen-models volume on
# first start. Set QWEN_MODEL_URL only to use a different file, or QWEN_MODEL_MOUNT
# to a host folder holding a .gguf you already have (then no download happens).
QWEN_MODEL_URL=
QWEN_MODEL_MOUNT=

# Learner check-ins. Every this many words spoken in a live room, the whole speech
# log is sent to Qwen, which decides whether a check-in summary is warranted. Only
# when it says yes is a summary written and pushed to the learners, in their own
# languages. Lower this to check in more often; raise it for long, dense sessions.
CHECKIN_WORD_INTERVAL=500
