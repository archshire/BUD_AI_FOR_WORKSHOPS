# LiveKit settings for the teacher-hosted prototype
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=bud-demo-room

# Provider settings: local uses Whisper + NLLB + Qwen by default. Set
# LLM_PROVIDER=openai to use the OpenAI Chat Completions API for Bud replies.
# Set STT_PROVIDER=groq and TRANSLATION_PROVIDER=groq, gemini, or qwen when configured.
STT_PROVIDER=local
TRANSLATION_PROVIDER=nllb
LLM_PROVIDER=qwen

# Hosted OpenAI Bud replies. Used only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=chat-latest
OPENAI_BASE_URL=https://api.openai.com/v1

# Local Whisper service
STT_HOST=127.0.0.1
STT_PORT=8787
WHISPER_MODEL=small
TRANSLATION_HOST=127.0.0.1
TRANSLATION_PORT=8788

# Local Qwen service. Compose defaults to a Docker volume. On hosts with
# limited Docker storage, set QWEN_MODEL_MOUNT=/tmp/bud-qwen-model (or another
# local directory with enough room) before the first start.
QWEN_MODEL_FILE=
QWEN_MODEL_URL=
QWEN_MODEL_MOUNT=

# Optional host mounts for persistent workshop memory and Caddy's local TLS
# certificate. Useful when moving Docker's data root or using limited storage.
SOURCE_PACK_MOUNT=
CADDY_DATA_MOUNT=

# Number of transcribed words in a workshop or breakout before Bud evaluates
# whether learners should receive a private check-in summary.
CHECKIN_WORD_INTERVAL=500
