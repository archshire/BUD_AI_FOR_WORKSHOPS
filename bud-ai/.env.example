# LiveKit settings for the teacher-hosted prototype
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=bud-demo-room

# Provider settings: local uses Whisper + NLLB by default. Set STT_PROVIDER=groq and TRANSLATION_PROVIDER=groq, gemini, or qwen when configured.
STT_PROVIDER=local
TRANSLATION_PROVIDER=nllb
LLM_PROVIDER=dev

# Local Whisper service
STT_HOST=127.0.0.1
STT_PORT=8787
WHISPER_MODEL=small
TRANSLATION_HOST=127.0.0.1
TRANSLATION_PORT=8788

# Local Qwen service. Compose downloads the pinned default model into the
# qwen-models Docker volume on first start. Override these only for a different
# GGUF filename/source or a host directory that already contains the model.
QWEN_MODEL_FILE=
QWEN_MODEL_URL=
QWEN_MODEL_MOUNT=

# Number of transcribed words in a workshop or breakout before Bud evaluates
# whether learners should receive a private check-in summary.
CHECKIN_WORD_INTERVAL=500
