# LiveKit settings for the teacher-hosted prototype
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=bud-demo-room

# Future provider settings
STT_PROVIDER=
TRANSLATION_PROVIDER=
LLM_PROVIDER=dev

# Translation backend: groq | gemini | qwen | nllb
# Left unset, Groq is used when GROQ_API_KEY is present, then Gemini when
# GEMINI_API_KEY is present, and NLLB otherwise.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_TRANSLATE_MODEL=llama-3.3-70b-versatile

# Hosted speech-to-text (Groq, whisper-large-v3). Set GROQ_API_KEY and Bud will use
# Groq automatically, with local Whisper as fallback. Set STT_PROVIDER=local to force
# the local container.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
STT_NO_SPEECH_THRESHOLD=0.6
STT_LOG_PROB_THRESHOLD=-1.0
STT_COMPRESSION_RATIO_THRESHOLD=2.4

# Local Whisper service
STT_HOST=127.0.0.1
STT_PORT=8787
WHISPER_MODEL=small
TRANSLATION_HOST=127.0.0.1
TRANSLATION_PORT=8788

# Learner check-ins. Every this many spoken words, Bud asks the local model whether a
# private recap is warranted. Set higher for fewer interruptions.
CHECKIN_WORD_INTERVAL=500
